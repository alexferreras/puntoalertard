# Motor de visión: auto (Claude si hay API key, mock si no) | mock | claude
PUNTOALERTA_VISION_ENGINE=auto

# Requerida solo si PUNTOALERTA_VISION_ENGINE=claude. Sin ella, `auto` usa el motor mock.
ANTHROPIC_API_KEY=

# Proveedor meteorológico: open_meteo | mock
PUNTOALERTA_WEATHER_PROVIDER=open_meteo

# Servidor de rutas OSRM.
PUNTOALERTA_OSRM_URL=https://router.project-osrm.org

# Nombre del fichero SQLite dentro de data/ (sin rutas).
PUNTOALERTA_DB_FILE=puntoalertard.db

# Habilita escenarios meteorológicos simulados y el endpoint de seed.
DEMO_MODE=true

# Código de acceso del dashboard de operador. Cámbialo en cualquier despliegue real.
PUNTOALERTA_OPERATOR_CODE=operador-demo

# Secreto de firma de sesiones (>=16 caracteres). Sin él se genera uno efímero
# por proceso y las sesiones se invalidan en cada reinicio.
PUNTOALERTA_SESSION_SECRET=
